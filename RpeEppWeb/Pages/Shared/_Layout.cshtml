<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Control EPP</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<header class="border-bottom bg-light">
    <nav class="container navbar navbar-expand-lg navbar-light">
        <a class="navbar-brand fw-bold" asp-page="/Index">Control EPP</a>
        <div class="navbar-nav">
            <a class="nav-link" asp-page="/Index">Buscar trabajador</a>
            <a class="nav-link" asp-page="/Workers/Create">Registrar trabajador</a>
        </div>
    </nav>
</header>
<main class="container py-4">
    @RenderBody()
</main>
</body>
</html>
