@page "{id:int}"
@model RpeEppWeb.Pages.Workers.DetailsModel
@{
    ViewData["Title"] = "Documentos del trabajador";
}

@if (Model.Worker is null)
{
    <div class="alert alert-danger">Trabajador no encontrado.</div>
    return;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Vista de EPP</h1>
    <a class="btn btn-outline-secondary" asp-page="/Index" asp-route-rpe="@Model.Worker.Rpe">Volver a búsqueda</a>
</div>

@if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
{
    <div class="alert alert-info">@Model.StatusMessage</div>
}

<div class="page-panel p-3">
    <div class="table-responsive">
        <table class="table table-bordered align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>RPE</th>
                    <th>Foto</th>
                    <th>Nombre</th>
                    <th>Checklist</th>
                    <th>Gestión de documentos (PDF)</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td><strong>@Model.Worker.Rpe</strong></td>
                    <td>
                        <img class="worker-photo" src="@(Model.Worker.FotoPath ?? "https://placehold.co/120x120?text=Sin+foto")" alt="Foto trabajador" />
                    </td>
                    <td>@Model.Worker.Nombre</td>
                    <td>
                        @foreach (var tipo in Model.RequiredTypes)
                        {
                            var hasDoc = Model.Worker.Documents.Any(d => d.Tipo == tipo);
                            <div class="form-check mb-1">
                                <input class="form-check-input" type="checkbox" checked="@hasDoc" disabled />
                                <label class="form-check-label">@Model.GetLabel(tipo)</label>
                            </div>
                        }
                    </td>
                    <td>
                        <div class="table-responsive">
                            <table class="table table-sm table-docs mb-0">
                                <thead>
                                    <tr>
                                        <th>Documento</th>
                                        <th>Estado</th>
                                        <th>Acciones</th>
                                        <th>Subir/Reemplazar</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var tipo in Model.RequiredTypes)
                                    {
                                        var doc = Model.Worker.Documents.FirstOrDefault(d => d.Tipo == tipo);
                                        <tr>
                                            <td>@Model.GetLabel(tipo)</td>
                                            <td>
                                                @if (doc is not null)
                                                {
                                                    <span class="badge bg-success">Cargado</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">Pendiente</span>
                                                }
                                            </td>
                                            <td>
                                                @if (doc is not null)
                                                {
                                                    <a class="btn btn-sm btn-outline-primary mb-1" href="@doc.FilePath" target="_blank">Ver PDF</a>
                                                    <form method="post" asp-page-handler="DeleteDocument" class="d-inline">
                                                        <input type="hidden" name="workerId" value="@Model.Worker.Id" />
                                                        <input type="hidden" name="tipo" value="@tipo" />
                                                        <button class="btn btn-sm btn-outline-danger mb-1" type="submit">Eliminar</button>
                                                    </form>
                                                }
                                            </td>
                                            <td>
                                                <form method="post" enctype="multipart/form-data" asp-page-handler="UploadDocument">
                                                    <input type="hidden" name="workerId" value="@Model.Worker.Id" />
                                                    <input type="hidden" name="tipo" value="@tipo" />
                                                    <div class="input-group input-group-sm">
                                                        <input type="file" name="pdfFile" class="form-control" accept=".pdf" required />
                                                        <button class="btn btn-primary" type="submit">Subir</button>
                                                    </div>
                                                </form>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>
