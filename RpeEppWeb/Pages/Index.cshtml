@page
@model RpeEppWeb.Pages.IndexModel
@{
    ViewData["Title"] = "Buscar trabajador";
}

<h1 class="h3">Buscar por RPE</h1>

<form method="get" class="row g-2 align-items-end mb-4 page-panel p-3">
    <div class="col-sm-4">
        <label asp-for="Rpe" class="form-label">RPE (máx. 5 letras)</label>
        <input asp-for="Rpe" class="form-control" placeholder="ABCDE" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">Buscar</button>
    </div>
</form>

@if (Model.Worker is null && !string.IsNullOrWhiteSpace(Model.Rpe))
{
    <div class="alert alert-warning">No se encontró trabajador con ese RPE.</div>
}

@if (Model.Worker is not null)
{
    <div class="page-panel p-3">
        <div class="table-responsive">
            <table class="table table-bordered align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>RPE</th>
                        <th>Foto</th>
                        <th>Nombre</th>
                        <th>Checklist</th>
                        <th>Acción</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td><strong>@Model.Worker.Rpe</strong></td>
                        <td><img class="worker-photo" src="@(Model.Worker.FotoPath ?? "https://placehold.co/120x120?text=Sin+foto")" alt="Foto trabajador" /></td>
                        <td>@Model.Worker.Nombre</td>
                        <td>
                            @foreach (var tipo in Model.RequiredTypes)
                            {
                                var loaded = Model.UploadedTypes.Contains(tipo);
                                <div class="form-check mb-1">
                                    <input class="form-check-input" type="checkbox" checked="@loaded" disabled />
                                    <label class="form-check-label">@Model.GetLabel(tipo)</label>
                                </div>
                            }
                        </td>
                        <td>
                            <a class="btn btn-outline-primary" asp-page="/Workers/Details" asp-route-id="@Model.Worker.Id">
                                Ver y administrar
                            </a>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
}
